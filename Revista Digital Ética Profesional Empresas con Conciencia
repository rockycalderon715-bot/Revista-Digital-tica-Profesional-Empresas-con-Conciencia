                        btn.className = "page-num-btn px-2.5 py-1 rounded text-xs font-semibold bg-navy-900 text-gold-400 dark:bg-gold-500 dark:text-navy-900";
                    } else {
                        btn.className = "page-num-btn px-2.5 py-1 rounded text-xs font-semibold hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300";
                    }
                }
            }

            document.getElementById('page-indicator').innerText = `Página ${currentPage} de ${totalPages}`;
            document.getElementById('page-title-indicator').innerText = pageTitles[currentPage - 1];

            document.getElementById('prev-btn').disabled = (currentPage === 1);
            document.getElementById('next-btn').disabled = (currentPage === totalPages);
        }

        function nextPage() {
            if (currentPage < totalPages) {
                currentPage++;
                updatePageDisplay();
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }
        }

        function prevPage() {
            if (currentPage > 1) {
                currentPage--;
                updatePageDisplay();
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }
        }

        function goToPage(pageNumber) {
            currentPage = pageNumber;
            if (isContinuousView) {
                toggleViewMode();
            }
            updatePageDisplay();
            const modal = document.getElementById('toc-modal');
            if (!modal.classList.contains('hidden')) {
                toggleModal('toc-modal');
            }
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function toggleViewMode() {
            isContinuousView = !isContinuousView;
            const magazineViewer = document.getElementById('magazine-viewer');
            const scrollViewer = document.getElementById('scroll-viewer');
            const viewModeText = document.getElementById('view-mode-text');
            const viewModeIcon = document.getElementById('view-mode-icon');

            if (isContinuousView) {
                scrollViewer.innerHTML = '';
                for (let i = 1; i <= totalPages; i++) {
                    const originalPage = document.getElementById(`page-${i}`);
                    const clone = originalPage.cloneNode(true);
                    clone.classList.remove('hidden');
                    scrollViewer.appendChild(clone);
                }

                magazineViewer.classList.add('hidden');
                scrollViewer.classList.remove('hidden');
                viewModeText.innerText = "Vista Diapositivas";
                viewModeIcon.className = "fa-solid fa-book-open";
            } else {
                magazineViewer.classList.remove('hidden');
                scrollViewer.classList.add('hidden');
                viewModeText.innerText = "Vista Continua";
                viewModeIcon.className = "fa-solid fa-scroll";
                updatePageDisplay();
            }
        }

        function toggleDarkMode() {
            document.documentElement.classList.toggle('dark');
        }

        function toggleModal(modalId) {
            const modal = document.getElementById(modalId);
            if (modal) {
                modal.classList.toggle('hidden');
            }
        }

        document.addEventListener('keydown', (e) => {
            if (!isContinuousView) {
                if (e.key === 'ArrowRight') nextPage();
                if (e.key === 'ArrowLeft') prevPage();
            }
        });

        window.onload = function () {
            updatePageDisplay();
        };
    </script>
</body>
</html>
